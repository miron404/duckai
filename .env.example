# Copy this file to .env and adjust the values (see "Configuration" in the
# README). Only the user agent normally has to be set: the current duck.ai
# frontend version, its SHA and the bundle URL are discovered at runtime.

# --- Server ---
PORT=3000
HOST=0.0.0.0

# When set, clients must send "Authorization: Bearer <value>". Leave empty to
# keep the API open (only sensible when HOST is a loopback address).
# OPENAI_API_KEY=

# --- Duck.ai client headers ---
# Copy the "User-Agent" header from a duck.ai chat request.
X_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36"

# Optional Accept-Language override (default: en-US,en;q=0.9).
# X_ACCEPT_LANGUAGE=

# --- duck.ai durable stream (optional) ---
# RSA-OAEP public key as printed by `bun run stream-key`. The duck.ai frontend
# uses durableStream only to resume an interrupted stream, so this is not needed
# for normal chat requests. When set, every request carries
# durableStream { conversationId, messageId, publicKey }.
# STREAM_KEY={"publicKey":{"kty":"RSA","n":"...","e":"AQAB",...}}
# X_COOKIE=atb=...; ah=...

# --- Manual overrides (normally auto-discovered) ---
# X_VQD_STACK=
# X_FE_VERSION=

# --- Optional ---
# Set to "1" to expose the model reasoning as "reasoning_content" in responses.
# X_EMIT_REASONING=1

# Replace the built-in model list entirely (JSON object). See the README for
# the expected format.
# X_MODELS_JSON={"my-model":{"reasoning_effort":"none","valid_reasoning_efforts":["none","low"]}}

# --- Tuning (defaults shown) ---
# X_MAX_REQUESTS_PER_MINUTE=20
# X_MIN_REQUEST_INTERVAL_MS=1000
# X_MAX_ATTEMPTS=3
# X_RETRY_BASE_DELAY_MS=600
# X_RETRY_MAX_DELAY_MS=8000
# X_DISCOVERY_TTL_MS=600000
# X_REQUEST_TIMEOUT_MS=120000
# X_STREAM_TIMEOUT_MS=600000
# X_MAX_BODY_BYTES=26214400
