{
  "name": "duckai-openai-server",
  "version": "1.0.0",
  "description": "OpenAI-compatible HTTP server using Duck.ai backend",
  "main": "src/server.ts",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:openai": "DUCKAI_LIVE=1 bun test tests/openai-simple.test.ts",
    "test:openai-full": "DUCKAI_LIVE=1 bun test tests/openai-library.test.ts",
    "test:tools": "bun test tests/tool-service.test.ts tests/openai-tools.test.ts",
    "test:e2e": "DUCKAI_LIVE=1 bun test tests/e2e-tools.test.ts",
    "test:all": "DUCKAI_LIVE=1 bun test tests/server.test.ts tests/openai-simple.test.ts tests/tool-service.test.ts tests/openai-tools.test.ts",
    "probe": "bun run scripts/duck-probe.ts",
    "typecheck": "tsc --noEmit",
    "stream-key": "bun run scripts/generate-stream-key.ts"
  },
  "dependencies": {
    "jsdom": "^25.0.1",
    "openai": "^4.104.0",
    "user-agents": "^1.1.675"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/user-agents": "^1.0.4",
    "bun-types": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  }
}
